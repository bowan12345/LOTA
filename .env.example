# Copy this file to .env for local docker compose.
# On Hostinger, set the same keys in GitHub Secrets / Docker Manager env.
# Do not commit real passwords.

MSSQL_SA_PASSWORD=ChangeMe_Sql_P@ssw0rd
ADMIN_EMAIL=admin@yourdomain.ac.nz
ADMIN_PASSWORD=ChangeMe_Admin_P@ssw0rd

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_DISPLAY_NAME=LOTA System

# Leave DOMAIN empty to use http://VPS_IP first.
